# Application Settings
PROJECT_NAME="Insurance Claim Support AI System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (JSON array or comma-separated origins)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="insurance_claims_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/insurance_claims_db"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/insurance_claims_db"

# AI Services Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
CHROMA_PERSIST_DIR="./chroma_db"

# Cloud Multimodal Vision Model Configuration
VISION_PROVIDER="groq"
VISION_MODEL="llama-3.2-11b-vision-instruct"
VISION_API_KEY="" # Replace with your Cloud Groq API Key 

